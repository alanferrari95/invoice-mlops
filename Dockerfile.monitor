FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY requirements-monitor.txt .
RUN pip install --no-cache-dir -r requirements-monitor.txt
COPY src/ /app/src/
# drift-check job uses this entrypoint; risk-pipeline-launcher overrides the command
# with `python -m src.launcher`.
ENTRYPOINT ["python", "-m", "src.monitoring.drift"]
