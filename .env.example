# cp .env.example .env   (.env is gitignored). Pick ONE extraction backend.

# --- /extract backend: off | ollama | gemini-api | vertex -----------------------
EXTRACT_BACKEND=off

# ollama: a local model, no account, no key. CPU works; a GPU makes it usable.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# gemini-api: Gemini Developer API key (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# vertex: Gemini on Vertex AI with your Google credentials (no key):
#   gcloud auth application-default login; set GOOGLE_CLOUD_PROJECT.
GOOGLE_CLOUD_PROJECT=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LOCATION=eu

PROMPT_VERSION=v2

# --- prediction / extraction log: stdout | none | bigquery ---------------------
LOG_SINK=stdout
